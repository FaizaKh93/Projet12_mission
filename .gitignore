# ============================================================
# Projet 12 - Agritech Answers
# ============================================================

# ---------- Données ----------
# Les CSV sources pèsent ~90 Mo : jamais dans git (limite GitHub = 100 Mo/fichier,
# et un fichier commité reste dans l'historique même après suppression).
data/
# Exception possible si tu veux versionner de petits échantillons :
# !data/samples/
# !data/samples/*.csv

# ---------- Modèles et artefacts ML ----------
artifacts/
*.pkl
*.joblib
*.onnx
*.h5

# Exception : le modèle retenu est un livrable de la mission.
# Le Pipeline sérialisé pèse quelques Ko, il peut être versionné sans gêne.
models/*
!models/.gitkeep
!models/modele_final.joblib
# L'artefact de service et sa provenance : l'image Docker les copie au build,
# et une CI n'a pas accès au registre MLflow local. 7 Ko à eux deux.
!models/modele_api.joblib
!models/modele_api.json
# Ceux du service national, pour les mêmes raisons. L'artefact est plus gros —
# 54 Ko — parce qu'il embarque les derniers retards de 1 106 séries : c'est ce
# qui permet à l'API de répondre à (pays, culture) sans accès aux données.
!models/modele_api_panel.joblib
!models/modele_api_panel.json

# ---------- MLflow ----------
# Tracking local : volumineux et propre à ta machine.
mlruns/
mlartifacts/
mlflow.db

# ---------- Environnement Python ----------
.venv/
venv/
env/
# NB : .python-version et uv.lock DOIVENT être versionnés (reproductibilité) -> non ignorés.

# ---------- Secrets ----------
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---------- Cache Python ----------
__pycache__/
*.py[cod]
*.so
.Python

# ---------- Packaging ----------
build/
dist/
*.egg-info/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Qualité de code et tests ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ---------- Couverture de code ----------
# Sorties regenerables : `uv run pytest --cov` les reproduit.
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---------- Logs ----------
*.log
logs/

# ---------- IDE ----------
.vscode/
.idea/

# ---------- OS ----------
Thumbs.db
Desktop.ini
.DS_Store
